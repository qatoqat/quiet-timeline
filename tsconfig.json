{
  // Type-check the plain JS (no build step, nothing emitted): catches undefined
  // names, typos in DOM / chrome APIs, wrong argument counts.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["chrome"],
    "skipLibCheck": true
  },
  "include": ["src/*.js", "popup/*.js", "src/globals.d.ts"]
}
